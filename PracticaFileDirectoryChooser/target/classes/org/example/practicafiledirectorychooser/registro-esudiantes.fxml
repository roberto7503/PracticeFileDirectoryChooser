<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane
        prefHeight="461.0"
        prefWidth="442.0"
        xmlns="http://javafx.com/javafx/17.0.12"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="org.example.practicafiledirectorychooser.RegistroEstudiantesController">

    <children>

        <Label
                layoutX="22.0"
                layoutY="22.0"
                text="Registro de Estudiantes">

            <font>
                <Font name="System Bold" size="16.0"/>
            </font>

        </Label>


        <Label
                layoutX="22.0"
                layoutY="80.0"
                text="Carnet"/>


        <TextField
                fx:id="txtCarnet"
                layoutX="22.0"
                layoutY="105.0"
                prefWidth="400.0"
                promptText="Número de carnet"/>


        <Label
                layoutX="22.0"
                layoutY="150.0"
                text="Nombre completo"/>


        <TextField
                fx:id="txtNombreEstudiante"
                layoutX="22.0"
                layoutY="175.0"
                prefWidth="400.0"
                promptText="Nombre del estudiante"/>


        <Button
                layoutX="22.0"
                layoutY="240.0"
                mnemonicParsing="false"
                onAction="#guardarEstudiante"
                text="Guardar Estudiante"
                style="-fx-background-color: #66B2FF;"/>

    </children>

</AnchorPane>